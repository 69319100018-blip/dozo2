# Set these in Vercel Project Settings -> Environment Variables.
DATABASE_URL=
SESSION_SECRET=
# Vercel Blob private store credentials are linked by Vercel when you connect the store.

# --- LINE Messaging API (แจ้งเตือนออเดอร์ใหม่) ---
# LINE Notify ปิดแล้ว ใช้ Official Account + Messaging API แทน
LINE_CHANNEL_ACCESS_TOKEN=
# userId หรือ groupId ของคน/กลุ่มที่รับแจ้งเตือน (คั่นด้วย comma ถ้าหลายคน)
LINE_NOTIFY_TO=
# แนะนำ: ใช้ตรวจลายเซ็น webhook /api/line-webhook
LINE_CHANNEL_SECRET=
